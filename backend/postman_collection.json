{
  "info": {
    "name": "Auth Service",
    "_postman_id": "auth-service-sample",
    "description": "Signup and Login collection",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "item": [
    {
      "name": "Signup",
      "request": {
        "method": "POST",
        "header": [
          { "key": "Content-Type", "value": "application/json" }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"name\": \"Alice Example\",\n  \"email\": \"alice@example.com\",\n  \"password\": \"S3cureP@ss\"\n}"
        },
        "url": { "raw": "http://localhost:5000/signup", "protocol": "http", "host": ["localhost"], "port": "5000", "path": ["signup"] }
      }
    },
    {
      "name": "Login",
      "request": {
        "method": "POST",
        "header": [
          { "key": "Content-Type", "value": "application/json" }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"email\": \"alice@example.com\",\n  \"password\": \"S3cureP@ss\"\n}"
        },
        "url": { "raw": "http://localhost:5000/login", "protocol": "http", "host": ["localhost"], "port": "5000", "path": ["login"] }
      }
    }
  ]
}
